<Window x:Class="BlitztextWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext Windows" Height="720" Width="980" MinHeight="640" MinWidth="880"
        Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="16" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Blitztext" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Windows 11 Preview" Foreground="#687386" Margin="0,2,0,16" />

                    <TextBlock Text="OpenAI API Key" FontWeight="SemiBold" />
                    <PasswordBox x:Name="ApiKeyBox" PasswordChar="*" />
                    <Button x:Name="SaveApiKeyButton" Content="API Key speichern" Click="SaveApiKeyButton_Click" />

                    <Separator Margin="0,14" />

                    <TextBlock Text="Sprache" FontWeight="SemiBold" />
                    <TextBox x:Name="LanguageBox" Text="de" />

                    <TextBlock Text="Fachbegriffe" FontWeight="SemiBold" />
                    <TextBox x:Name="CustomTermsBox" AcceptsReturn="True" MinHeight="66"
                             TextWrapping="Wrap" />

                    <TextBlock Text="Kontext fuer Blitztext+" FontWeight="SemiBold" />
                    <TextBox x:Name="ContextBox" AcceptsReturn="True" MinHeight="66"
                             TextWrapping="Wrap" />

                    <TextBlock Text="Ton fuer Blitztext+" FontWeight="SemiBold" />
                    <ComboBox x:Name="ToneBox" Margin="0,4,0,10">
                        <ComboBoxItem Content="Neutral" Tag="Neutral" IsSelected="True" />
                        <ComboBoxItem Content="Formell" Tag="Formal" />
                        <ComboBoxItem Content="Locker" Tag="Casual" />
                    </ComboBox>

                    <TextBlock Text="Emoji-Dichte" FontWeight="SemiBold" />
                    <ComboBox x:Name="EmojiDensityBox" Margin="0,4,0,10">
                        <ComboBoxItem Content="Wenig" Tag="Wenig" />
                        <ComboBoxItem Content="Mittel" Tag="Mittel" IsSelected="True" />
                        <ComboBoxItem Content="Viel" Tag="Viel" />
                    </ComboBox>

                    <CheckBox x:Name="AutoPasteBox" Content="Nach Hotkey automatisch einfuegen" IsChecked="True" Margin="0,6,0,0" />
                    <Button x:Name="SaveSettingsButton" Content="Einstellungen speichern" Click="SaveSettingsButton_Click" Margin="0,14,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Padding="18" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Workflows" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Bereit." Foreground="#687386" Margin="0,3,0,12" />
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,4,0,14">
                    <Button x:Name="TranscriptionButton" Click="WorkflowButton_Click" Tag="Transcription">
                        <StackPanel>
                            <TextBlock Text="Blitztext" FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl + Shift + Space" FontSize="11" Foreground="#687386" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImproveButton" Click="WorkflowButton_Click" Tag="TextImprover">
                        <StackPanel>
                            <TextBlock Text="Blitztext+" FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl + Alt + Space" FontSize="11" Foreground="#687386" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DampfButton" Click="WorkflowButton_Click" Tag="DampfAblassen">
                        <StackPanel>
                            <TextBlock Text="Blitztext $%&amp;!" FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl + Alt + R" FontSize="11" Foreground="#687386" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EmojiButton" Click="WorkflowButton_Click" Tag="EmojiText">
                        <StackPanel>
                            <TextBlock Text="Blitztext :)" FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl + Alt + E" FontSize="11" Foreground="#687386" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBox x:Name="ResultBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="15" Padding="12"
                         Text="Noch kein Ergebnis." />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="CopyButton" Content="Ergebnis kopieren" Click="CopyButton_Click" />
                    <Button x:Name="HideButton" Content="In Tray minimieren" Click="HideButton_Click" Margin="8,4,0,4" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
